---
import { val2Int } from "@ingenieria_insoft/ispgen";
import UsuarioInSoft from "$layouts/UsuarioInSoft.astro";
import Mensajes from "$views/leads/Mensajes.svelte";

export const prerender = false;

const ilead: number = val2Int(Astro.params.ilead);
---

<UsuarioInSoft title={`Mensajes del lead ${ilead}`}>
	<Mensajes client:only="svelte" ilead={ilead} />
</UsuarioInSoft>
