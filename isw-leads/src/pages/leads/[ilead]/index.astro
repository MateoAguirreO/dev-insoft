---
import { val2Int } from "@ingenieria_insoft/ispgen";
import UsuarioInSoft from "$layouts/UsuarioInSoft.astro";
import Lead from "$views/leads/Lead.svelte";

export const prerender = false;

const ilead: number = val2Int(Astro.params.ilead);
---

<UsuarioInSoft title={`Lead ${ilead}`}>
	<Lead client:only="svelte" ilead={ilead} />
</UsuarioInSoft>
