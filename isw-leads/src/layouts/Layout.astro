---
import { Toaster } from "@ingenieria_insoft/ispsveltecomponents";
import "$styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="es-CO">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Datos personales de leads (Ley 1581 de 2012): ninguna página se indexa -->
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>{title} · Leads · ContaPyme®</title>
	</head>
	<body class="flex min-h-svh flex-col bg-white">
		<Toaster client:only="svelte" />
		<header class="bg-azul-oscuro text-white">
			<div class="mx-auto flex w-full max-w-6xl items-center px-4 py-3">
				<a href="/leads" class="flex items-baseline gap-2 text-white hover:opacity-80">
					<span class="text-lg font-bold">ContaPyme<sup class="text-[0.5em]">®</sup></span>
					<span class="text-sm font-semibold text-azul-primario">Leads</span>
				</a>
			</div>
		</header>
		<main class="mx-auto flex w-full max-w-6xl flex-1 flex-col px-4 py-6">
			<slot />
		</main>
	</body>
</html>
