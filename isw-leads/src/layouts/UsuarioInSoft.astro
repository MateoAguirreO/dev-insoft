---
import CerrarSesion from "$components/navigation/CerrarSesion.svelte";
import Layout from "./Layout.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
// src/middleware.ts ya exige la sesión en las rutas privadas: aquí solo se muestra quién la tiene
const usuario: string = Astro.locals.sesion?.usuario ?? "";
---

<Layout title={title}>
	<div slot="cabecera" class="ml-auto flex items-center gap-3">
		<span class="hidden text-sm text-white/85 sm:inline">{usuario}</span>
		<CerrarSesion client:only="svelte" />
	</div>
	<slot />
</Layout>
